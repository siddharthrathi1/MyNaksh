# ---- Shared Brain storage ----
# neo4j | memory (in-process, for running without Docker)
BRAIN_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mynaksh-dev-pass

# ---- LLM ----
# openai | anthropic | fake   (fake = deterministic offline replies, no key needed)
LLM_PROVIDER=openai
# blank = provider default (gpt-4o-mini / claude-opus-5-5)
LLM_MODEL=
# optional second provider used when the primary fails, e.g. anthropic
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Memory & context ----
# auto | llm | rules
EXTRACTION_MODE=auto
# sync = memories_written returned in the response; background = lower latency
MEMORY_WRITE_MODE=sync
MEMORY_CONFIDENCE_THRESHOLD=0.6
SHORT_TERM_TURNS=6
MAX_MEMORIES_IN_CONTEXT=8
CONTEXT_TOKEN_BUDGET=1500
